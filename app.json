{
  "expo": {
    "name": "Daily Goals",
    "slug": "daily-goals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailygoals",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.patrickoneill.dailygoals",
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": ["iCloud.com.patrickoneill.dailygoals"],
        "com.apple.developer.icloud-services": ["CloudDocuments"],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.patrickoneill.dailygoals"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF5E4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-calendar",
        {
          "remindersPermission": "Daily Goals reads the unfinished reminders in your Today list to suggest them as today's goals."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF5E4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#171410",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-background-task",
      "@react-native-community/datetimepicker",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TodayGoals",
              "displayName": "Today's Goals",
              "description": "Today's daily goals and how far along each one is.",
              "ios": {
                "supportedFamilies": ["systemSmall"]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/daily-goals"
    },
    "extra": {
      "eas": {
        "projectId": "dde37e87-c439-41c4-8d31-821884114afd"
      }
    },
    "owner": "poneill91",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/dde37e87-c439-41c4-8d31-821884114afd"
    }
  }
}
